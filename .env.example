# Copy to .env for local development (or run ../scripts/secrets-sync.mjs). Never commit values.
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Comma-separated CORS and CSRF allow-list of bare origins
APP_ORIGIN=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
APP_VERSION=dev
DATABASE_URL=
DATABASE_URL_DIRECT=
DATABASE_URL_TEST=
